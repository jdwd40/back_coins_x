# Coins → Supabase migration — environment variable NAMES only.
# Never commit real values. Copy to .env.local / .env.staging and fill in.

# --- Shared Supabase instance (server-side scripts only; never in frontend) ---
# Read-capable connection for the read-only inventory script.
SUPABASE_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Direct DB connection used by import/verify scripts (staging only).
COINS_STAGING_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Supabase Admin API (GoTrue) — staging only, short-lived use.
SUPABASE_URL=https://supabase.jdwd40.xyz
SUPABASE_SERVICE_ROLE_KEY=replace-me-staging-only

# --- Legacy source (read-only export) ---
COINS_SOURCE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Market worker (restricted role; NOT the service role) ---
COINS_WORKER_DATABASE_URL=postgresql://coins_worker:PASSWORD@HOST:5432/postgres
MARKET_WORKER_ID=coins-worker-1
TICK_INTERVAL_MS=30000

# --- Archive gate for retention (set by ops after archive verification) ---
# Applied as: ALTER DATABASE ... SET coins.archive_confirmed = 'on'
COINS_ARCHIVE_CONFIRMED=off
